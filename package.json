{
  "name": "mediflow-web",
  "version": "1.0.0",
  "description": "MediFlow Web - AI-Assisted Doctor Appointment & Virtual Waiting-Room Platform (Web Application)",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node server/index.js"
  },
  "keywords": [
    "healthcare",
    "appointment-booking",
    "virtual-waiting-room",
    "ai-preconsultation",
    "live-queue",
    "react",
    "vite",
    "express"
  ],
  "author": "MediFlow Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  }
}
