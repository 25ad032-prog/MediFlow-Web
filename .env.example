# ==========================================
# MediFlow Web - Environment Configuration
# ==========================================

# Server Port (Auto-injected by Render/Railway, defaults to 5000)
PORT=5000

# Node Environment ('production' for unified deployment serving client/dist)
NODE_ENV=production

# Authentication Secret for signing secure JSON Web Tokens & Session Cookies
AUTH_SECRET=mediflow_jwt_secure_key_2026_change_in_production
SESSION_SECRET=mediflow_session_secret_2026_change_in_production

# Optional CORS Origin (defaults to allow all on same-origin)
# CORS_ORIGIN=*

# Optional AI / LLM API Key (Backend service abstraction only; NEVER expose to client)
# AI_SERVICE_API_KEY=your_optional_api_key_here

# ==========================================
# Healthcare Interoperability & FHIR API (HL7 R4)
# ==========================================
# Enable External FHIR REST API integration (default: false, uses synthetic FHIR provider)
FHIR_ENABLED=false

# External Hospital / EHR FHIR Base URL (e.g. http://localhost:8080/fhir or https://hapi.fhir.org/baseR4)
FHIR_BASE_URL=

# External FHIR Bearer Token / API Key (Optional)
FHIR_API_KEY=
