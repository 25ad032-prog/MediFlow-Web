# ==========================================
# MediFlow Web - Environment Configuration
# ==========================================

# Server Port (Auto-injected by Render/Railway, defaults to 5000)
PORT=5000

# Node Environment ('production' for unified deployment serving client/dist)
NODE_ENV=production

# Optional CORS Origin (defaults to allow all on same-origin)
# CORS_ORIGIN=*

# Optional AI / LLM API Key (Backend service abstraction only; NEVER expose to client)
# AI_SERVICE_API_KEY=your_optional_api_key_here
